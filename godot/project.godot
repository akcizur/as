; Openworld Simulation v2.2 — Godot 4.6.1
; The browser build targets the Compatibility renderer (WebGL 2.0).

config_version=5

[application]
config/name="Openworld Simulation"
config/description="A third-person open-world sandbox simulation."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/window_width_override=1280
window/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":10)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}
reset_player={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":3)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":4194326), Object(InputEventJoypadButton,"button_index":7)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadButton,"button_index":9)]
}
turn_180={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88), Object(InputEventJoypadButton,"button_index":8)]
}
spawn_crate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66), Object(InputEventJoypadButton,"button_index":1)]
}

[physics]
3d/default_gravity=9.8

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.085, 1)
